# Copy to .env only if your run configuration loads env files. Never commit real values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional paid alternative. Gemini is tried first when both keys are present.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Healthcare Appointment Manager
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/calendar/callback
APP_TIME_ZONE=Asia/Kolkata

# Production-only examples (leave unset for local H2)
# SPRING_PROFILES_ACTIVE=prod
# DATABASE_URL=jdbc:postgresql://localhost:5432/healthcare
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=
